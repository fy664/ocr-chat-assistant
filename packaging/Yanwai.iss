; 言外 Yanwai · Windows installer (per-user, no admin)
; Build with: ISCC.exe packaging\Yanwai.iss
; The payload is generated by packaging\build_portable.ps1 and contains no
; .env / config.json / API key / user logs.

#define AppName "言外"
#define AppVersion "2.0.0"
#define AppPublisher "fy664"
#define AppURL "https://github.com/fy664/ocr-chat-assistant"

[Setup]
AppId={{32FD792A-4166-404F-8E49-ED315F9EEF40}
AppName={#AppName}
AppVersion={#AppVersion}
AppVerName={#AppName} {#AppVersion}
AppPublisher={#AppPublisher}
AppPublisherURL={#AppURL}
AppSupportURL={#AppURL}
AppUpdatesURL={#AppURL}/releases
VersionInfoVersion=2.0.0.0
DefaultDirName={localappdata}\Programs\Yanwai
DefaultGroupName={#AppName}
DisableProgramGroupPage=yes
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
OutputDir=..\_packaging\dist
OutputBaseFilename=setup
SetupIconFile=..\assets\app.ico
UninstallDisplayIcon={app}\assets\app.ico
UninstallDisplayName={#AppName}
WizardStyle=modern
Compression=lzma2/ultra64
SolidCompression=yes
LZMAUseSeparateProcess=yes
SetupLogging=yes
CloseApplications=no
RestartApplications=no
AllowNoIcons=yes
DisableWelcomePage=no

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "创建桌面快捷方式"; GroupDescription: "附加快捷方式："

[Files]
Source: "..\_packaging\portable\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{group}\{#AppName}"; Filename: "{app}\runtime\pythonw.exe"; Parameters: """{app}\run.py"""; WorkingDir: "{app}"; IconFilename: "{app}\assets\app.ico"
Name: "{group}\卸载 {#AppName}"; Filename: "{uninstallexe}"
Name: "{autodesktop}\{#AppName}"; Filename: "{app}\runtime\pythonw.exe"; Parameters: """{app}\run.py"""; WorkingDir: "{app}"; IconFilename: "{app}\assets\app.ico"; Tasks: desktopicon

[Run]
Filename: "{app}\runtime\pythonw.exe"; Parameters: """{app}\run.py"""; WorkingDir: "{app}"; Description: "启动 {#AppName}"; Flags: nowait postinstall skipifsilent

[Registry]
; Browser launch protocol: yanwai://launch
Root: HKCU; Subkey: "Software\Classes\yanwai"; ValueType: string; ValueName: ""; ValueData: "URL:言外 Protocol"; Flags: uninsdeletekey
Root: HKCU; Subkey: "Software\Classes\yanwai"; ValueType: string; ValueName: "URL Protocol"; ValueData: ""; Flags: uninsdeletevalue
Root: HKCU; Subkey: "Software\Classes\yanwai\DefaultIcon"; ValueType: string; ValueName: ""; ValueData: "{app}\assets\app.ico,0"
Root: HKCU; Subkey: "Software\Classes\yanwai\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\runtime\pythonw.exe"" ""{app}\run.py"""
